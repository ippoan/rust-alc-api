load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("@crates//:defs.bzl", "all_crate_deps")

_WORKSPACE_CRATES = [
    "//crates/alc-core",
    "//crates/alc-misc",
    "//crates/alc-storage",
]

rust_library(
    name = "rust_alc_api_lib",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = [
            "src/main.rs",
            "src/bin/**",
        ],
    ),
    crate_name = "rust_alc_api",
    deps = all_crate_deps(normal = True) + _WORKSPACE_CRATES,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
)

rust_binary(
    name = "rust-alc-api",
    srcs = ["src/main.rs"],
    deps = [":rust_alc_api_lib"] + all_crate_deps(normal = True) + _WORKSPACE_CRATES,
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_binary(
    name = "migrate",
    srcs = ["src/bin/migrate.rs"],
    # migrate.rs は alc-migrations/sqlx/tokio/anyhow しか使わない。all_crate_deps(normal) だと
    # root package の全 external deps を要求し、staging image 用に //:migrate を
    # 全 build-image matrix job (per-service bazel cache) で build する際に
    # monolith の dep closure を抱え込むため、明示 deps に絞る (Refs #482)。
    deps = [
        "@crates//:alc-migrations",
        "@crates//:anyhow",
        "@crates//:sqlx",
        "@crates//:tokio",
    ],
)

rust_binary(
    name = "archive",
    srcs = ["src/bin/archive.rs"],
    deps = [":rust_alc_api_lib"] + all_crate_deps(normal = True) + _WORKSPACE_CRATES,
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_test(
    name = "unit_tests",
    crate = ":rust_alc_api_lib",
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)

# --- mock 統合テスト (DB 不要、Refs #515 bazel gate 移行 PR1) ---
#
# tests/mock_<domain>/main.rs が #[path] で tests/common + tests/mock_helpers +
# tests/mock_tests を束ねる dir-style integration test。mock repository で
# AppState を組み、実 HTTP サーバーを spawn する。
# postgres には接続しない (pool: None) ので bazel sandbox でそのまま走る。
# 新しい mock shard を足したら ci.yml の bazel test matrix (warm/poc) にも
# 追記すること (check_bazel_test_matrix.sh が同期漏れを loud fail する)。

_MOCK_TEST_SRCS = glob([
    "tests/common/**/*.rs",
    "tests/mock_helpers/**/*.rs",
    "tests/mock_tests/**/*.rs",
])

# --- DB integration テスト (postgres 必須、Refs #515 bazel gate 移行 PR2) ---
#
# ci.yml の bazel-test-db job (postgres service + TEST_DATABASE_URL) で走らせる。
# migration・初期化・GRANT の SQL は ippoan/alc-migrations の crate に埋め込み済み (tests/common の
# migrate_and_grant が空の DB を初期化する) なので compile_data は要らない。新 target を足したら ci.yml の db matrix にも追記
# (check_bazel_test_matrix.sh が poc/db の union で同期を検証する)。

# テスト DB の alc_api_app の権限が本番と揃っているか (Refs #685)。新しい表の GRANT
# 付け忘れを落とす。ci.yml の bazel-test-db と cache-warm.yml を同じ内容にすること
# (check_bazel_test_matrix.sh が pair 一致を検査する)
rust_test(
    name = "app_role_grants_test",
    srcs = ["tests/app_role_grants_test.rs"] + glob(["tests/common/**/*.rs"]),
    crate_root = "tests/app_role_grants_test.rs",
    deps = [":rust_alc_api_lib"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ) + _WORKSPACE_CRATES,
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
)

